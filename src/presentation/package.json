{
  "name": "presentation",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "A clean, accessible presentation editor with real PPTX files and Puter cloud storage.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "patch-package --error-on-fail",
    "typecheck": "tsc --noEmit -p lib/tsconfig.json"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "lucide": "1.34.0",
    "nspell": "2.1.5",
    "unicode-segmenter": "0.17.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.58.2",
    "@types/node": "24.13.2",
    "patch-package": "8.0.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vite": "8.2.0",
    "vitest": "4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HeyPuter/presentation.git"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
