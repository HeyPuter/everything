{
  "name": "circuits",
  "version": "0.1.0",
  "description": "Circuits: schematic capture and PCB layout in the browser. Draw schematics, lay out boards with WebGL rendering, pour copper, check design rules and export Gerber files, stored in your own Puter cloud.",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --manifest-path wasm/kernel/Cargo.toml",
    "build:wasm": "node tools/build-wasm.mjs",
    "check:licenses": "node tools/check-licenses.mjs",
    "prebuild": "npm run check:licenses"
  },
  "dependencies": {
    "earcut": "3.2.4",
    "fflate": "0.8.3",
    "lucide": "1.55.0",
    "rbush": "4.0.1"
  },
  "devDependencies": {
    "axe-core": "4.14.0",
    "jsdom": "30.1.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
