{
  "name": "documents",
  "version": "1.0.0",
  "description": "Documents: a fast, private word processor on Puter. Real .docx files in your own cloud.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:licenses": "node tools/check-licenses.mjs",
    "prebuild": "npm run check:licenses",
    "test:browser": "playwright test",
    "check:conformance": "python3 tools/check-docx-schema.py"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HeyPuter/documents.git"
  },
  "dependencies": {
    "@zip.js/zip.js": "2.14.1",
    "bidi-js": "1.0.3",
    "fflate": "0.8.3",
    "hast-util-to-html": "9.0.5",
    "lucide": "^1.34.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-to-hast": "13.2.1",
    "mdast-util-to-markdown": "2.1.2",
    "micromark-extension-gfm": "3.0.0",
    "nspell": "2.1.5",
    "opentype.js": "2.0.0",
    "rtf.js": "3.0.9",
    "utif": "3.1.0",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "commonmark": "0.31.2",
    "jsdom": "^27.0.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
