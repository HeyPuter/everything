    <Folder>
      <name>Sights</name>
      <Placemark id="p1">
        <name>Old Town Hall</name>
        <address>Main Square 1</address>
        <description><![CDATA[<p>Built in <b>1420</b>.</p><script>alert(1)</script><p>Tours daily &amp; free</p>]]></description>
        <ExtendedData><Data name="category"><value>attraction</value></Data></ExtendedData>
        <Point><coordinates>14.4207,50.0875,0</coordinates></Point>
      </Placemark>
      <Placemark>
        <name>Market</name>
        <MultiGeometry>
          <Point><coordinates>14.4300,50.0800</coordinates></Point>
          <LineString><coordinates>14.43,50.08 14.44,50.085 14.45,50.09</coordinates></LineString>
        </MultiGeometry>
      </Placemark>
    </Folder>
    <Placemark>
      <name>River path</name>
