    </Placemark>
    <Placemark>
      <name>GPS log</name>
      <gx:Track>
        <when>2026-05-01T10:00:00Z</when><when>2026-05-01T10:05:00Z</when>
        <gx:coord>14.42 50.08 200</gx:coord>
        <gx:coord>14.43 50.09 210</gx:coord>
