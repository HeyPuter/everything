    "fzstd": "0.1.1",
    "opentype.js": "1.3.4",
    "three": "0.186.1",
    "three-bvh-csg": "0.0.18",
    "three-gpu-pathtracer": "0.0.24",
    "three-mesh-bvh": "0.9.15",
    "xatlas-web": "0.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/opentype.js": "1.3.8",
    "@types/three": "0.186.0",
    "gltf-validator": "^2.0.0-dev.3.10",
    "happy-dom": "20.14.5",
    "prettier": "^3.9.8",
    "pyodide": "314.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
