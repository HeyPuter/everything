    def Scope "_materials"
    {
        def Material "Red" (
            prepend apiSchemas = ["ColorSpaceAPI"]
        )
        {
            uniform token colorSpace:name = "lin_rec709_scene"
            token outputs:surface.connect = </root/_materials/Red/Principled_BSDF.outputs:surface>
            custom string userProperties:blender:data_name = "Red"

            def Shader "Principled_BSDF"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.03
                color3f inputs:diffuseColor = (0.8, 0.05, 0.05)
                float inputs:ior = 1.5
                float inputs:metallic = 0.3
                float inputs:opacity = 1
                float inputs:roughness = 0.6
                float inputs:specular = 0.5
                token outputs:surface
            }
        }

        def Material "Blue" (
            prepend apiSchemas = ["ColorSpaceAPI"]
        )
        {
            uniform token colorSpace:name = "lin_rec709_scene"
            token outputs:surface.connect = </root/_materials/Blue/Principled_BSDF.outputs:surface>
            custom string userProperties:blender:data_name = "Blue"

            def Shader "Principled_BSDF"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.03
                color3f inputs:diffuseColor = (0.05, 0.1, 0.8)
                float inputs:ior = 1.5
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.2
                float inputs:specular = 0.5
                token outputs:surface
            }
        }

        def Material "Textured" (
            prepend apiSchemas = ["ColorSpaceAPI"]
        )
        {
            uniform token colorSpace:name = "lin_rec709_scene"
            token outputs:surface.connect = </root/_materials/Textured/Principled_BSDF.outputs:surface>
            custom string userProperties:blender:data_name = "Textured"

            def Shader "Principled_BSDF"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.03
                color3f inputs:diffuseColor.connect = </root/_materials/Textured/Image_Texture.outputs:rgb>
                float inputs:ior = 1.5
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.5
                float inputs:specular = 0.5
                token outputs:surface
            }

            def Shader "Image_Texture" (
                prepend apiSchemas = ["ColorSpaceAPI"]
            )
            {
                uniform token colorSpace:name = "srgb_rec709_display"
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/checker.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </root/_materials/Textured/uvmap.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "uvmap"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }
        }
    }

