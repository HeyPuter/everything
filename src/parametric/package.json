{
  "name": "parametric",
  "version": "0.1.0",
  "description": "Parametric: feature-based 3D part modeling in the browser. Sketch with constraints, extrude, revolve, fillet, shell and pattern on a real B-rep kernel, then export STEP and STL, stored in your own Puter cloud.",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:licenses": "node tools/check-licenses.mjs",
    "prebuild": "npm run check:licenses"
  },
  "dependencies": {
    "lucide": "1.55.0",
    "replicad": "1.1.0",
    "replicad-opencascadejs": "1.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "axe-core": "4.14.0",
    "jsdom": "30.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
